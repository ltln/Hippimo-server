datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client-js"
  output       = "prisma.client"
  moduleFormat = "cjs"
  engineType   = "library"
}

// ================= ENUMS =================

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum NotificationsType {
  BUDGET_WARNING
  ABNORMAL_SPENDING
  SYSTEM
}

enum InsightType {
  HABIT_ANALYSIS
  PREDICTION
  HEALTH_SCORE
}

enum RoleAiChatMess {
  USER
  ASSISTANT
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetPeriodType {
  WEEK
  MONTH
  YEAR
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum UserProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum WalletType {
  CASH
  BANK_ACCOUNT
  E_WALLET
  CREDIT_CARD
  SAVINGS
  OTHER
}

// ================= MODELS =================

model User {
  userId          String       @id @default(uuid()) @map("user_id") @db.Uuid
  email           String       @unique @db.VarChar(100)
  fullName        String?      @map("full_name") @db.VarChar(50)
  currency        String       @default("VND") @db.VarChar(10)
  provider        UserProvider @default(GOOGLE)
  providerSubject String?      @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  wallets           Wallet[]
  categories        Category[]
  transactions      Transaction[]
  receipts          Receipt[]
  budgets           Budget[]
  notifications     Notification[]
  financialInsights FinancialInsight[]
  aiChatSessions    AiChatSession[]

  @@unique([provider, providerSubject])
  @@map("users")
}

model Wallet {
  walletId  String     @id @default(uuid()) @map("wallet_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  name      String     @map("name_wallet") @db.VarChar(50)
  type      WalletType
  balance   Decimal    @db.Decimal(15, 2)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")

  user                            User          @relation(fields: [userId], references: [userId])
  transactions                    Transaction[] @relation("TransactionWallet")
  transferDestinationTransactions Transaction[] @relation("TransactionDestinationWallet")

  @@map("wallets")
}

model Category {
  categoryId String         @id @default(uuid()) @map("category_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  name       String         @db.VarChar(50)
  type       CategoryType
  icon       String?        @db.VarChar(255)
  color      String?        @db.VarChar(20)
  status     CategoryStatus @default(ACTIVE)

  user         User          @relation(fields: [userId], references: [userId])
  transactions Transaction[] @relation("CategoryToTransaction")
  aiSuggested  Transaction[] @relation("AiSuggestedCategory")
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  transactionId         String          @id @default(uuid()) @map("transaction_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  walletId              String          @map("wallet_id") @db.Uuid
  toWalletId            String?         @map("to_wallet_id") @db.Uuid
  categoryId            String?         @map("category_id") @db.Uuid
  amount                Decimal         @db.Decimal(15, 2)
  type                  TransactionType
  transactionDate       DateTime        @map("transaction_date")
  notes                 String?         @db.Text
  isExcludedFromReport  Boolean         @default(false) @map("is_excluded_from_report")
  aiSuggestedCategoryId String?         @map("ai_suggested_category_id") @db.Uuid
  isEssential           Boolean         @default(false) @map("is_essential")
  createdAt             DateTime        @default(now()) @map("created_at")
  deletedAt             DateTime?       @map("deleted_at")

  // Relations
  user                User      @relation(fields: [userId], references: [userId])
  wallet              Wallet    @relation("TransactionWallet", fields: [walletId], references: [walletId])
  toWallet            Wallet?   @relation("TransactionDestinationWallet", fields: [toWalletId], references: [walletId])
  category            Category? @relation("CategoryToTransaction", fields: [categoryId], references: [categoryId])
  aiSuggestedCategory Category? @relation("AiSuggestedCategory", fields: [aiSuggestedCategoryId], references: [categoryId])

  receipts      Receipt[]
  notifications Notification[]

  @@map("transactions")
}

model Receipt {
  receiptId         String            @id @default(uuid()) @map("receipt_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  transactionId     String            @map("transaction_id") @db.Uuid
  imageUrl          String            @map("image_url") @db.Text
  extractedText     String?           @map("extracted_text") @db.Text
  extractedAmount   Decimal?          @map("extracted_amount") @db.Decimal(15, 2)
  extractedMerchant String?           @map("extracted_merchant") @db.VarChar(100)
  status            TransactionStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [userId])
  transaction Transaction @relation(fields: [transactionId], references: [transactionId])

  @@map("receipts")
}

model Budget {
  budgetId              String           @id @default(uuid()) @map("budget_id") @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  categoryId            String           @map("category_id") @db.Uuid
  amountLimit           Decimal          @map("amount_limit") @db.Decimal(15, 2)
  periodType            BudgetPeriodType @map("period_type")
  periodStart           DateTime         @map("period_start")
  periodEnd             DateTime         @map("period_end")
  alertThresholdPercent Int              @default(80) @map("alert_threshold_percent")

  user     User     @relation(fields: [userId], references: [userId])
  category Category @relation(fields: [categoryId], references: [categoryId])

  @@unique([userId, categoryId, periodType, periodStart])
  @@map("budgets")
}

model Notification {
  notificationId       String             @id @default(uuid()) @map("notification_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  title                String             @db.VarChar(255)
  content              String             @db.Text
  type                 NotificationsType
  status               NotificationStatus @default(UNREAD)
  relatedTransactionId String?            @map("related_transaction_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [userId])
  transaction Transaction? @relation(fields: [relatedTransactionId], references: [transactionId])

  @@map("notifications")
}

model FinancialInsight {
  financialInsightsId String      @id @default(uuid()) @map("financial_insights_id") @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  insightType         InsightType @map("insight_type")
  title               String      @db.VarChar(255)
  content             String      @db.Text
  score               Int?
  predictedAmount     Decimal?    @map("predicted_amount") @db.Decimal(15, 2)
  targetPeriod        String?     @map("target_period") @db.VarChar(50)
  createdAt           DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("financial_insights")
}

model AiChatSession {
  aiChatSessionId String   @id @default(uuid()) @map("ai_chat_session_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  title           String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [userId])
  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  aiChatMessId String         @id @default(uuid()) @map("ai_chat_mess_id") @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  role         RoleAiChatMess
  content      String         @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")

  session AiChatSession @relation(fields: [sessionId], references: [aiChatSessionId])

  @@map("ai_chat_messages")
}
